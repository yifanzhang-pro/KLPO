  "algo.kl.init_coef": 0,
  "eval.steps": 100,
  "eval.n_samples_per_prompt": 4,
  "eval.temperature": 0.7,
  "eval.top_p": 0.7,
  "eval.eval_at_start": true,
  "ckpt.save_steps": 10,
  "logger.logging_steps": 1,
  "vllm.sync_backend": "nccl",
  "vllm.gpu_memory_utilization": 0.9,
  "train.force_sync_mode": true,
  "actor.klpo_route": "token",
  "actor.klpo_kl_estimator": "mc",
  "actor.klpo_beta": 0.1,
  "actor.klpo_mc_samples": 128,
  "actor.klpo_top_k": 128,
  "actor.klpo_tail_floor": 1e-06,
  "algo.advantage.no_whiten": true,
  "algo.advantage.gamma": 1.0
